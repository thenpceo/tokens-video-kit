{
  "name": "tokens-postability-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tokens-specific postability engine: registry-driven ingestion, hard gates, Slack queues, source scoring.",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "worker": "tsx src/worker.ts",
    "slack:server": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "ingest:once": "tsx src/cli/ingestOnce.ts",
    "report:sources": "tsx src/cli/reportSources.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
